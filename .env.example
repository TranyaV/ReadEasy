# ReadEase AI Assistant (Google Gemini)
#
# Copy this file to .env.local and fill in your own key. .env.local is gitignored.
# The key is read only on the server (src/lib/assistant/providers/index.ts).
#
# IMPORTANT: never prefix this with NEXT_PUBLIC_ — that prefix tells Next.js to
# bundle the value into client-side JavaScript, which would expose it to every
# visitor's browser.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: override the default model (gemini-3.6-flash).
# GEMINI_MODEL=
